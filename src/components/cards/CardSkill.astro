---
interface Props {
  imagePath: string;
  name: string;
  alt: string;
}

const { imagePath, name, alt }: Props = Astro.props;
---

<div class="card">
  <div class="body">
    <img src={imagePath} alt={`${alt} skill icon`} loading="lazy" />
    <p class="title">{name}</p>
  </div>
</div>

<style>
  .card {
    border-radius: 1rem;
    padding: 1rem;
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--glass-border);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .card .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 100%;
  }

  .card .body img {
    width: auto;
    height: 45px;
  }

  .card .body p.title {
    font-size: 16px;
    font-weight: 500;
    color: var(--font-color);
  }

  @media (max-width: 480px) {
    .card {
      border-radius: 0.8rem;
      padding: 0.8rem;
    }

    .card .body img {
      height: 35px;
    }
    .card .body p.title {
      font-size: 14px;
    }
  }
</style>
