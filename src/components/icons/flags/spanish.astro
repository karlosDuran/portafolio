---
interface Props {
  height?: number;
  width?: number;
}

const { height = 40, width = 40 }: Props = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 84 56"
  id="mexico"
  width={width}
  height={height}
  aria-label="Español (México)"
  role="img"
>
  <title>Español (México)</title>
  <rect width="84" height="56" rx="4" fill="#CE1126" />
  <rect width="56" height="56" rx="4" fill="#fff" />
  <rect width="28" height="56" rx="4" fill="#006847" />
  <!-- Simplified eagle emblem -->
  <g transform="translate(42, 28)" fill="#58301B">
    <ellipse rx="5" ry="3.5" fill="#006847" opacity="0.6" />
    <path d="M-3,-6 C-1,-3 0,-1 0,0 C0,-1 1,-3 3,-6" stroke="#58301B" stroke-width="1.2" fill="none" />
    <circle r="1.2" cy="-2" fill="#58301B" />
    <path d="M-4,1 Q-2,4 0,2 Q2,4 4,1" stroke="#006847" stroke-width="0.8" fill="none" />
  </g>
</svg>
